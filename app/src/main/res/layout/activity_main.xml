<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0E1A"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="30dp">

        <ImageView
    android:layout_width="52dp"
    android:layout_height="52dp"
    android:src="@drawable/logo"
    android:layout_marginEnd="12dp"/>

<TextView
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:text="Vehicle Info"
    android:textColor="#FFFFFF"
    android:textSize="22sp"
    android:textStyle="bold"/>
         
            

        <TextView
            android:id="@+id/settingsIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙️"
            android:textSize="24sp"
            android:padding="8dp"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Search any vehicle owner details"
        android:textColor="#8890A8"
        android:textSize="13sp"
        android:layout_marginTop="4dp"/>

    <EditText
        android:id="@+id/vehicleInput"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:hint="Enter vehicle number (e.g. JH10DK0021)"
        android:textColorHint="#4A5470"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:background="#161B2E"
        android:padding="16dp"
        android:layout_marginTop="24dp"
        android:inputType="textCapCharacters"/>

    <Button
        android:id="@+id/searchBtn"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="🔍 Search Owner Details"
        android:textColor="#000000"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#00D09C"
        android:layout_marginTop="12dp"/>

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="24dp"
        android:visibility="gone"
        android:indeterminateTint="#00D09C"/>

    <LinearLayout
        android:id="@+id/resultCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#161B2E"
        android:padding="20dp"
        android:layout_marginTop="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✓ VEHICLE FOUND"
            android:textColor="#00D09C"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VEHICLE NUMBER"
            android:textColor="#8890A8"
            android:textSize="11sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/vehicleValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="#0F1420"
            android:padding="14dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OWNER MOBILE"
            android:textColor="#8890A8"
            android:textSize="11sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/mobileValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="#0F1420"
            android:padding="14dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CHASSIS NUMBER"
            android:textColor="#8890A8"
            android:textSize="11sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/chassisValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="#0F1420"
            android:padding="14dp"
            android:layout_marginTop="6dp"/>

    </LinearLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#8890A8"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginTop="12dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Application by Tanvir\nPowered by Tanvir"
        android:textColor="#8890A8"
        android:textSize="13sp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="16dp"/>

</LinearLayout>
